<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sean Harvey Orga Tech & Automation Specialist</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              500: '#6366f1',
              600: '#4f46e5',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#0b0f17] text-slate-200 font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <header class="fixed top-0 left-0 right-0 z-50 bg-[#0b0f17]/80 backdrop-blur-md border-b border-slate-800/80">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="font-mono font-bold text-lg text-white tracking-tight flex items-center gap-2">
        <span class="text-indigo-400">&lt;/&gt;</span> dev.sean
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-400">
        <a href="#about" class="hover:text-white transition">About</a>
        <a href="#stack" class="hover:text-white transition">Stack</a>
        <a href="#projects" class="hover:text-white transition">Projects</a>
        <a href="#services" class="hover:text-white transition">Services</a>
      </nav>
      <a href="#contact" class="px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-500/20">
        Let's Connect
      </a>
    </div>
  </header>

  <section class="pt-36 pb-20 px-6 max-w-6xl mx-auto">
    <div class="flex flex-col items-start gap-6 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Available for freelance & contract roles
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
        Bridging clean design, code, and <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400">scalable automation</span>.
      </h1>

      <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
        I design responsive web experiences, build high-converting funnels, and wire complex marketing workflows that save hours of manual overhead.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#projects" class="px-6 py-3 rounded-lg bg-white text-slate-950 font-semibold hover:bg-slate-200 transition">
          View Projects
        </a>
        <a href="#contact" class="px-6 py-3 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-semibold hover:border-slate-700 hover:text-white transition">
          Book a Discovery Call
        </a>
      </div>
    </div>
  </section>

  <section id="stack" class="py-16 px-6 border-y border-slate-850 bg-slate-900/40">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-xs font-mono uppercase tracking-widest text-indigo-400 mb-8">Core Arsenal & Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">Tailwind CSS</p>
          <span class="text-xs text-slate-500">Styling & UI</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">JavaScript / TS</p>
          <span class="text-xs text-slate-500">Frontend Logic</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">WordPress / CMS</p>
          <span class="text-xs text-slate-500">Custom Builds</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">GoHighLevel</p>
          <span class="text-xs text-slate-500">Funnels & Workflows</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">Zapier / Make</p>
          <span class="text-xs text-slate-500">Integrations</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center hover:border-indigo-500/50 transition">
          <p class="font-bold text-white text-sm">Video & Media</p>
          <span class="text-xs text-slate-500">Post-Production</span>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="py-24 px-6 max-w-6xl mx-auto">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-indigo-400 mb-2">Portfolio</h2>
        <h3 class="text-3xl font-bold text-white">Selected Works & Systems</h3>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="group relative rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden hover:border-slate-700 transition">
        <div class="h-52 bg-gradient-to-tr from-indigo-900/40 via-slate-800 to-slate-900 p-6 flex flex-col justify-between">
          <span class="font-mono text-xs px-2.5 py-1 rounded bg-black/40 text-slate-300 backdrop-blur w-fit">Case Study #01</span>
          <div class="text-3xl font-extrabold text-white/10 group-hover:text-white/20 transition">AUTOMATION</div>
        </div>
        <div class="p-6">
          <h4 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition">High-Volume Lead Pipeline & Funnel</h4>
          <p class="text-sm text-slate-400 mb-4">
            Constructed a synchronized CRM funnel architecture integrating SMS/Email sequences, automated booking calendars, and webhooks.
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-400">
            <span class="bg-slate-800 px-2.5 py-1 rounded">GoHighLevel</span>
            <span class="bg-slate-800 px-2.5 py-1 rounded">Webhooks</span>
            <span class="bg-slate-800 px-2.5 py-1 rounded">Stripe API</span>
          </div>
        </div>
      </div>

      <div class="group relative rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden hover:border-slate-700 transition">
        <div class="h-52 bg-gradient-to-tr from-sky-900/40 via-slate-800 to-slate-900 p-6 flex flex-col justify-between">
          <span class="font-mono text-xs px-2.5 py-1 rounded bg-black/40 text-slate-300 backdrop-blur w-fit">Case Study #02</span>
          <div class="text-3xl font-extrabold text-white/10 group-hover:text-white/20 transition">WEB DEV</div>
        </div>
        <div class="p-6">
          <h4 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition">Custom Performance Brand Website</h4>
          <p class="text-sm text-slate-400 mb-4">
            Engineered a responsive, 99+ PageSpeed rated web experience with dynamic filter catalogs and custom CSS animations.
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-400">
            <span class="bg-slate-800 px-2.5 py-1 rounded">WordPress</span>
            <span class="bg-slate-800 px-2.5 py-1 rounded">Tailwind CSS</span>
            <span class="bg-slate-800 px-2.5 py-1 rounded">JavaScript</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-24 px-6 border-t border-slate-800 bg-[#080c13]">
    <div class="max-w-4xl mx-auto rounded-3xl bg-slate-900/80 border border-slate-800 p-8 sm:p-12">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="text-3xl font-bold text-white mb-3">Have a project in mind?</h2>
        <p class="text-slate-400 text-sm">Whether you need an end-to-end web deployment, automation wiring, or custom digital assets, drop a line.</p>
      </div>

      <form class="space-y-4 max-w-md mx-auto">
        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">NAME</label>
          <input type="text" placeholder="John Doe" class="w-full px-4 py-3 rounded-lg bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        </div>
        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">EMAIL</label>
          <input type="email" placeholder="john@example.com" class="w-full px-4 py-3 rounded-lg bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        </div>
        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">PROJECT DETAILS</label>
          <textarea rows="4" placeholder="Tell me about what you are building..." class="w-full px-4 py-3 rounded-lg bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-500 transition"></textarea>
        </div>
        <button type="button" class="w-full py-3.5 px-6 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition shadow-lg shadow-indigo-600/30">
          Send Message
        </button>
      </form>
    </div>
  </section>

  <footer class="py-8 px-6 text-center text-xs font-mono text-slate-600 border-t border-slate-900">
    <p>© 2026 dev.sean — Built with precision & clean code.</p>
  </footer>

</body>
</html>